{
  "name": "ai-architecture-nlweb-lite",
  "version": "0.1.0",
  "private": true,
  "description": "AI건축융합학과 홍보용 NLWeb-lite content pack for GitHub + Cloudflare Pages",
  "scripts": {
    "dev": "wrangler pages dev public --ip 0.0.0.0",
    "check:json": "node -e \"for (const f of ['public/data/department.json','public/data/faq.json','public/data/curriculum.json','public/data/admissions.json','public/data/suggested_questions.json','public/data/answer_policy.json','public/data/faculty.json','public/data/advanced_areas.json']) JSON.parse(require('fs').readFileSync(f,'utf8')); console.log('JSON OK')\"",
    "test:qa": "node --test tests/qa-core.test.mjs",
    "test": "npm run check:json && npm run test:qa"
  },
  "devDependencies": {
    "wrangler": "^4.107.0"
  }
}
